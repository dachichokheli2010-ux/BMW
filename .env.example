# Local/Node server. Account data is private; keep this directory persistent.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/bmw-garage.sqlite

# Use Neon instead of SQLite locally. Copy the full connection string from Neon.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require

# For an HTTPS reverse proxy, set the externally reachable origin.
# PUBLIC_ORIGIN=https://garage.example.com

# Private /admin sign-in, separate from public account registration/login.
# Store both only in ignored local env files or hosting provider server secrets.
# ADMIN_LOGIN_EMAIL=owner@your-domain.example
# ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$32_HEX_SALT$64_HEX_HASH
# Use npm run admin:configure to set these locally without exposing a password.
# Legacy ADMIN_EMAILS / ADMIN_USER_IDS settings no longer grant any access.
# Never commit a real credential or put it in public JavaScript/vercel.json.

# Optional public account password recovery and email verification (Resend).
# Set all three on the deployment, using a verified Resend sender/domain.
# PUBLIC_ORIGIN=https://your-real-domain.example
# RESEND_API_KEY=re_your_private_key
# ACCOUNT_MAIL_FROM=Motron <accounts@your-verified-domain.example>
