# Local/Node server. Account data is private; keep this directory persistent.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/bmw-garage.sqlite

# Use Neon instead of SQLite locally. Copy the full connection string from Neon.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require

# For an HTTPS reverse proxy, set the externally reachable origin.
# PUBLIC_ORIGIN=https://garage.example.com

# Optional real password recovery and email verification (Resend).
# Set all three on the deployment, using a verified Resend sender/domain.
# Never put these credentials in public JavaScript or commit .env.local.
# Community moderation: only verified emails in this server-only allowlist
# receive admin access. Vercel also accepts runtime settings in vercel.json.
# ADMIN_EMAILS=owner@your-domain.example
# Optional alternative when mail delivery is unavailable: exact account ID.
# ADMIN_USER_IDS=local:your-existing-account-id
# PUBLIC_ORIGIN=https://your-real-domain.example
# RESEND_API_KEY=re_your_private_key
# ACCOUNT_MAIL_FROM=APEX <accounts@your-verified-domain.example>
